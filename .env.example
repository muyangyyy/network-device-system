# ============================================================
# Docker 一键部署配置（deploy.sh / deploy.bat 会自动复制为 .env）
# 生产环境请务必修改 MYSQL_ROOT_PASSWORD 和 JWT_SECRET
# ============================================================

# --- 数据库 ---
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=network_device

# --- 对外端口（被占用时改这里即可，无需改 docker-compose.yml）---
FRONTEND_PORT=80
BACKEND_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379

# --- 安全 ---
# 长度建议 32 位以上，生产环境必须更换
JWT_SECRET=networkDeviceSystemSecretKey2026VeryLongAndSecureKey
